# ==============================================================================
# RAJPOOT TRADERS — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- 1. APPLICATION & BASE URL ---
NEXT_PUBLIC_APP_NAME="RAJPOOT TRADERS"
NEXT_PUBLIC_APP_URL="https://rajpoottraders.vercel.app"
PORT=3000
NODE_ENV="production"

# --- 2. MULTI-TENANT DATABASE CONNECTION ---
# MongoDB Atlas or PostgreSQL (Supabase / Neon)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.rajpoot.mongodb.net/rajpoot_traders_db?retryWrites=true&w=majority"
# OR PostgreSQL:
# DATABASE_URL="postgresql://postgres:<password>@db.xxx.supabase.co:5432/postgres"

# --- 3. CRYPTOGRAPHIC & SECURITY MASTER KEYS ---
# 64-character Hex string for AES-256-GCM KYC and CNIC Vault Encryption
AES_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Secret Bearer Token for Automated Midnight Cloud Backup Cron Job (/api/cron/backup)
CRON_SECRET="rajpoot_midnight_backup_secret_2026"
# Master JWT Auth Secret
NEXTAUTH_SECRET="your-super-secret-jwt-key-rajpoot-2026"

# --- 4. CLOUD ENCRYPTED BACKUP & MEDIA STORAGE (AWS S3 / Cloudflare R2) ---
# Used for Customer CNIC Photos, Guarantor KYC Vault, and Midnight Database Backups
STORAGE_PROVIDER="cloudflare_r2" # or "aws_s3"
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_key"
CLOUDFLARE_R2_BUCKET_NAME="rajpoot-backups-secure"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://assets.rajpoottraders.com"

# --- 5. PAKISTANI SMS & WHATSAPP NOTIFICATION GATEWAY ---
# WhatsApp Business API / Twilio / Local Pakistani Gateway (e.g., BrandSMS, Telenor, Zong)
WHATSAPP_API_TOKEN="your_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
SMS_GATEWAY_API_KEY="your_local_pakistan_sms_api_key"
SMS_SENDER_MASK="RAJPOOT"

# --- 6. GOOGLE MAPS & GEOLOCATION API ---
# For interactive AI pin drop and route navigation
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyHere"